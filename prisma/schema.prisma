  CodCamerire         String
  CodiceConto         String
  CodiceTipoServizio  String
  DateBill            DateTime
  DateJob             DateTime
  DocAnno             Int
  DocNumero           Int
  DocTipo             String
  Email               String
  IDTickets           Int
  IDBookingSubscriber String
  IdCard              String
  IdRestaurant        Int
  IdSala              Int
  IDTavolo            String
  Name                String
  NumeroCoperti       Int
  Pagato              Float
  PaymentMode         String
  RestaurantCode      String
  RecipientIssued     String
  Sconto              Float
  Servizio            Float
  Status              Float
