model mkt {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  dbUrl    String
  config   String
  cratedAt DateTime @default(now()) @db.Timestamp()
  updateAt DateTime @updatedAt
}

type appCrossOriginUserId {
  riff_app String
  id_app   String
}

type product {
  product     String[]
  catergories String[]
  attributes  String[]
}

model TicketData {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketData      Json
  restaurant_code String?  @default("")
  subscriber_code String?  @default("")
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

// per i ticket di DylogApp / Bacco 
model ticketListBaccoDylogAPP {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketData      Json
  restaurant_code String?  @default("")
  subscriber_code String   @default("DylogApp")
  orderWebInfo    Json
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

// Modello per dati di vendita standardizzati da diverse fonti
model SalesData {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  sourceType        String    // "signa" o "dylogapp"
  sourceId          String    // ID di riferimento nel sistema di origine
  
  // Dati temporali (per filtri su date)
  saleDate          DateTime  // Data della vendita standardizzata
  
  // Importi (per filtri su spesa)
  totalAmount       Float     // Importo totale dell'ordine
  
  // Dati cliente (per filtri per cliente)
  customerId        String?   // ID cliente standardizzato
  fidelityCard      String?   // Carta fedeltà
  
  // Metadati
  restaurant_code   String?   @default("")
  subscriber_code   String?   @default("")
  
  // Dati specifici per fonte
  sourceData        Json      // Dati originali in formato ridotto
  
  createdAt         DateTime  @default(now())
  updateAt          DateTime  @updatedAt

  // Indici per migliorare le prestazioni delle query
  @@index([customerId, saleDate])
  @@index([sourceType])
  @@index([totalAmount])
  @@index([restaurant_code])
}

// Metriche aggregate per cliente per analisi rapide
model CustomerSalesSummary {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId        String    @unique // ID cliente (riferimento alla collezione Customer)
  totalOrders       Int       // Numero totale di ordini
  totalSpent        Float     // Importo totale speso
  lastOrderDate     DateTime  // Data ultimo ordine
  firstOrderDate    DateTime  // Data primo ordine
  orderDates        Json      // Array di date degli ordini per calcolare frequenza
  
  // Metriche per origine
  signaOrders       Int       @default(0)
  signaSpent        Float     @default(0)
  dylogappOrders    Int       @default(0)
  dylogappSpent     Float     @default(0)
  
  restaurant_code   String?   @default("")
  createdAt         DateTime  @default(now())
  updateAt          DateTime  @updatedAt

  // Indici per migliorare le prestazioni delle query
  @@index([totalOrders])
  @@index([totalSpent])
  @@index([lastOrderDate])
}

// Modello per i dati grezzi dei movimenti Signa
model SignaMovimenti {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  movimentoData   Json
  restaurant_code String?  @default("")
  subscriber_code String?  @default("SIGNA")
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
  
  @@index([restaurant_code])
}
