generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Data {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  content      Json
  createdAt    DateTime     @default(now())
  createdAtIta String?
  requestLogs  RequestLog[]
}

model Customer {
  id                              String   @id @default(auto()) @map("_id") @db.ObjectId // MongoDB usa un tipo `String` per l'ID
  idReferenceGateway              String?  @default("")
  idCustomer                      String?  @default("")
  gender                          String?  @default("")
  name                            String?  @default("")
  surname                         String?  @default("")
  birth_data                      String?  @default("")
  vat_number                      String?  @default("")
  residence_address               String?  @default("")
  residence_zipcode               String?  @default("")
  residence_city                  String?  @default("")
  residence_province              String?  @default("")
  residence_region                String?  @default("")
  residence_state                 String?  @default("")
  domicile_address                String?  @default("")
  domicile_zipcode                String?  @default("")
  domicile_city                   String?  @default("")
  domicile_province               String?  @default("")
  domicile_region                 String?  @default("")
  domicile_state                  String?  @default("")
  mobile                          String?  @default("")
  email                           String?  @default("")
  publicCode                      String?  @default("")
  subscriber                      String?  @default("")
  arrived_from                    String?  @default("")
  fidelity_card_number            String?  @default("")
  consent_marketing               String?  @default("")
  consent_third_parties_marketing String?  @default("")
  dateCreation                    String?  @default("")
  dateLastUpdate                  String?  @default("")
  deleted                         String?  @default("")
  restaurant_code                 String?  @default("")
  subscriber_code                 String?  @default("")
  createdAt                       DateTime @default(now())
  updateAt                        DateTime @updatedAt
}

model RequestLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  method    String
  url       String
  dataId    String?  @db.ObjectId
  data      Data?    @relation(fields: [dataId], references: [id])
  headers   Json?
  status    Int?
  error     String?
  createdAt DateTime @default(now())
}

