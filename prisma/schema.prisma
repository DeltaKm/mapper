// query per dati nostri { "content.customerList" : {$exists:true}}
// type anagrafica inviata da EasyAppear
type customerListType {
  idReferenceGateway String
  idCustomer         String
  idCustomerExt      String
  gender             String
  surname            String
  brith_data         String
  fiscal_code        String
  business           String
  residence_address  String
  residence_zipcode  String
  residence_city     String
  residence_state    String
  phone              String
  email              String
  publicCode         String
  arrived_from       String
  }

model mkt {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  dbUrl    String
  config   String
  cratedAt DateTime @default(now()) @db.Timestamp()
  updateAt DateTime @updatedAt
}

type appCrossOriginUserId {
  riff_app String
  id_app   String
}

type product {
  product     String[]
  catergories String[]
  attributes  String[]
}

model TicketData {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketData      Json
  restaurant_code String?  @default("")
  subscriber_code String?  @default("")
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

// per i ticket di DylogApp / Bacco 
model ticketListBaccoDylogAPP {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  ticketData      Json
  restaurant_code String?  @default("")
  subscriber_code String   @default("DylogApp")
  orderWebInfo    Json
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
}

model SalesData {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  sourceType        String    // "signa" o "dylogapp"
  sourceId          String    // ID di riferimento nel sistema di origine
  
  // Dati temporali (per filtri su date)
  saleDate          DateTime  // Data della vendita standardizzata
  
  // Importi (per filtri su spesa)
  totalAmount       Float     // Importo totale dell'ordine
  
  // Dati cliente (per filtri per cliente)
  customerId        String?   // ID cliente standardizzato
  fidelityCard      String?   // Carta fedeltà
  
  // Metadati
  restaurant_code   String?   @default("")
  subscriber_code   String?   @default("")
  
  // Dati specifici per fonte
  sourceData        Json      // Dati originali in formato ridotto
  
  createdAt         DateTime  @default(now())
  updateAt          DateTime  @updatedAt

  // Indici per migliorare le prestazioni delle query
  @@index([customerId, saleDate])
  @@index([sourceType])
  @@index([totalAmount])
  @@index([restaurant_code])
}

model CustomerSalesSummary {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  customerId        String    @unique // ID cliente (riferimento alla collezione Customer)
  totalOrders       Int       // Numero totale di ordini
  totalSpent        Float     // Importo totale speso
  lastOrderDate     DateTime  // Data ultimo ordine
  firstOrderDate    DateTime  // Data primo ordine
  orderDates        Json      // Array di date degli ordini per calcolare frequenza
  
  // Metriche per origine
  signaOrders       Int       @default(0)
  signaSpent        Float     @default(0)
  dylogappOrders    Int       @default(0)
  dylogappSpent     Float     @default(0)
  
  restaurant_code   String?   @default("")
  createdAt         DateTime  @default(now())
  updateAt          DateTime  @updatedAt

  // Indici per migliorare le prestazioni delle query
  @@index([totalOrders])
  @@index([totalSpent])
  @@index([lastOrderDate])
}

// Modello per i dati grezzi dei movimenti Signa (vendite)
model SignaMovimentiVend {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  movimentoData   Json
  IDMovimentoPOS  String?  @default("") 
  restaurant_code String?  @default("")
  subscriber_code String?  @default("SIGNA")
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt
  
  @@index([restaurant_code])
  @@index([IDMovimentoPOS]) 
}


model SignaMovimenti {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  payload           Json
  idReferenceGateway String?  @default("")
  IDReferencePOS    String?  @default("")
  CodAzienda        String?  @default("")
  CodNegozio        String?  @default("")
  CodCommesso       String?  @default("")
  CodSconto         String?  @default("")
  MovimentoData     String?  @default("")
  MovimentoOra      String?  @default("")
  MovimentoAnno     Int?     @default(0)
  VenditaWeb        Boolean? @default(false)
  TaxFree           Boolean? @default(false)
  Noleggiato        Boolean? @default(false)
  Fatturato         Boolean? @default(false)
  restaurant_code   String?  @default("")
  subscriber_code   String?  @default("SIGNA")
  createdAt         DateTime @default(now())
  updateAt          DateTime @updatedAt
  
  @@index([restaurant_code])
  @@index([IDReferencePOS])
  @@index([idReferenceGateway])
}

model CustomerOrders {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  idCustomer      String? @default("")
  totalSpent      Float?   @default(0)
  totalOrders     Int?     @default(0)
  lastOrderDate   DateTime?
  firstOrderDate  DateTime?
  orderData       Json?
  orderDates      Json?
  restaurant_code String?  @default("")
  createdAt       DateTime @default(now())
  updateAt        DateTime @updatedAt

  @@index([restaurant_code])
  @@index([idCustomer])
}

model CustomerOrdersFlat {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  detail_id     String   @unique // Chiave univoca: ${public_code}_${order_id}_${riga}
  
  // Identificativi
  idCustomer    String   @default("") // idCustomerExt (Signa) / IDCustomer (Bacco)
  contact_key   String   @default("")
  order_id      String   // IDReferencePOS (Signa) / IDTickets (Bacco)
  public_code   String   // restaurant_code
  source        String   // "retail" o "restaurant"
  
  // Date
  order_date    DateTime
  order_time    String   @default("")
  order_year    Int      @default(0)
  
  // Tipo movimento
  movement_type String   @default("") // CodTipoMovimento (Signa) / DocTipo (Bacco)
  is_return     Boolean  @default(false)
  
  // Prodotto
  product_code  String   @default("")
  product_name  String   @default("")
  
  // Categorie
  category      String   @default("")
  subcategory   String   @default("") // Solo Signa
  brand         String   @default("") // Solo Signa
  
  // Attributi retail (solo Signa)
  season        String   @default("")
  color         String   @default("")
  size          String   @default("")
  
  // Quantità e prezzi
  quantity      Float    @default(0)
  unit_price    Float    @default(0)
  total_amount  Float    @default(0)
  
  // Metadata
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  
  // Indici per performance
  @@index([idCustomer, order_date])
  @@index([public_code, source])
  @@index([category])
  @@index([product_code])
  @@index([order_id])
  @@index([season])
  @@index([brand])
  @@index([movement_type])
  @@index([is_return])
  @@index([contact_key])
}


model BookingTable {
  id String  @id @default(auto()) @map("_id") @db.ObjectId

  subscriber String
  token String
  dateTimeStarBooking DateTime
  userID String
  userFristName String
  userSurname String
  userEmail String
  userTelephone String
  userNote String
  guestSurName String
  guestFirstName String
  guestTelephone String
  guestEmail String
  noteBooking String
  noteMerchant String
  nPersone Int
  status Int
  idTavolo String
  restaurantCode String
  consent_marketing String
  booking_channel String
  customer_typology String
  
  userCreatedAt DateTime
  userUpdatedAt DateTime
}
  
