  BillRow             Int
  Cameriere           String
  CodCamerire         String
  CommPreparazione    String
  Code                String
  ContoSepID          Int
  ContoSepName        String
  DataAcquisizione    DateTime
  GroupCode           String // da VALL IL TIPO Con Valerio
  GroupDescription    String
  IdentificazitvoPOS  String
  Name                String
  NSessioneComanda    String
  OrderIDGateway      String
  Peso                Float
